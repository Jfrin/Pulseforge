# Copy to .env
STORE_API_KEY=

# Mock source
MOCK_SEED=42
MOCK_BASE_GAMES=200

# source-connectors
SC_DB_USER=pulseforge
SC_DB_PASSWORD=pulseforge
POLL_INTERVAL_S=15
CATALOG_INTERVAL_S=300
BATCH_SIZE=500
BATCH_MAX_AGE_S=300

# MinIO / bronze landing
MINIO_ROOT_USER=pulseforge
MINIO_ROOT_PASSWORD=pulseforge-minio
MINIO_BUCKET=pulseforge
BRONZE_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30
# S3_IMAGE=pgsty/silo:RELEASE.2026-08-06T00-00-00Z   # or any other S3-compatible image

# CSV import (drop files into ./imports)
CSV_INTERVAL_S=30
CSV_ID_FIELD=external_id

# Real source: Steam reviews (documented public endpoint, no key). Off unless app ids are set.
# Check Valve's current terms before running it, and keep the polling gentle.
# STEAM_APP_IDS=570,730
STEAM_INTERVAL_S=300
STEAM_MAX_PAGES=10

# Core event pipeline
CORE_DB_PASSWORD=pulseforge
BROKER_USER=pulseforge
BROKER_PASSWORD=pulseforge
PSEUDONYM_SALT=dev-only-salt-change-me-0123456789
QUEUE_LAG_THRESHOLD=10000
SOURCE_RATE=5
ENRICHMENT_API_KEY=dev-stub-key

# Push connectors; use canonical game/review fields in the data envelope.
WEBHOOK_SOURCES=
SSE_SOURCES=
WEBSOCKET_SOURCES=
# Explicitly opt push sources into the canonical field mapper, e.g. webhook-demo,sse-demo.
ENVELOPE_SOURCES=

# Explainable review-bomb detector
DETECTOR_WINDOW_S=86400
DETECTOR_NEGATIVE_THRESHOLD=0.7
DETECTOR_MIN_REVIEWS=100
DETECTOR_COOLDOWN_S=43200

# Notifications are durably stored even when neither delivery channel is configured.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=pulseforge@localhost
SMTP_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
