# Copy to .env
STORE_API_KEY=

# Mock source
MOCK_SEED=42
MOCK_BASE_GAMES=200

# source-connectors
SC_DB_USER=pulseforge
SC_DB_PASSWORD=pulseforge
POLL_INTERVAL_S=15
CATALOG_INTERVAL_S=300
BATCH_SIZE=500
BATCH_MAX_AGE_S=300

# MinIO / bronze landing
MINIO_ROOT_USER=pulseforge
MINIO_ROOT_PASSWORD=pulseforge-minio
MINIO_BUCKET=pulseforge
# S3_IMAGE=pgsty/silo:RELEASE.2026-08-06T00-00-00Z   # or any other S3-compatible image

# CSV import (drop files into ./imports)
CSV_INTERVAL_S=30
CSV_ID_FIELD=external_id

# Real source: Steam reviews (documented public endpoint, no key). Off unless app ids are set.
# Check Valve's current terms before running it, and keep the polling gentle.
# STEAM_APP_IDS=570,730
STEAM_INTERVAL_S=300
STEAM_MAX_PAGES=10
