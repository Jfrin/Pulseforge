# syntax=docker/dockerfile:1
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY infra/requirements-core.txt .
RUN pip install --no-cache-dir -r requirements-core.txt

FROM builder AS test
RUN pip install --no-cache-dir pytest pytest-asyncio ruff mypy
WORKDIR /app
COPY libs /libs
COPY services /services
COPY tests/core /app/tests
COPY pyproject.toml /app/pyproject.toml
ENV PYTHONPATH="/libs:/services/processing"
CMD ["pytest", "-v"]

FROM python:3.12-slim AS runtime
RUN useradd --system --create-home --uid 10001 app
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH=/libs PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY libs /libs
ARG SERVICE
COPY services/${SERVICE}/app /app/app
USER app
CMD ["python", "-m", "pulseforge.runtime"]
